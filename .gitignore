# Nested research/vendor checkouts. Their own repositories remain local
# dependencies; Albion Reforged tracks the native runtime and project docs.
/auto-re-agent/
/Fable2AssetBrowser/
/Fable2Recomp/
/REPlugins/
/rexglue-src/
/rexglue-sdk/
/rexglue-sdk-nightly/
/xenia/
/XenonRecomp/
/_research/
/_research_skate3recomp/
/third_party/

# Retail reference screenshots (copyrighted — never commit)
/resources/
# Local research binary
Fable2Native/tools/decode_large_ring.exe
# Native render screenshots and local cook scratch (large/derived — never commit)
/native_shots/
/scratchpad/

# Generated decompiled-Lua reference tree (derived from a user-supplied game copy;
# regenerate with tools/lua_mod/decompile_all.py). Not committed by default.
/lua-decompiled/
